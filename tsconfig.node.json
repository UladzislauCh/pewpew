{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    /* No "DOM" on purpose: everything reachable from here — including the detection code shared
       with the app — must stay runnable in Node for the evaluation harness to work. */
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["vite.config.ts", "vitest.config.ts", "scripts", "eval"],
  /* Страницы, которые по замыслу живут в браузере: одна проверяет WebCodecs, которого
     в Node нет, вторая достаёт им кадры для разбора ошибок. Типы им даёт tsconfig.app.json. */
  "exclude": ["eval/decodeCheck.ts", "eval/errorReview.ts", "eval/weaponRegion.ts", "eval/weaponSignal.ts", "eval/viewmodel.ts", "eval/weighted.ts", "eval/saveResult.ts", "eval/browserCheck.ts", "eval/prodRun.ts", "eval/stacks.ts", "eval/ammoBrowser.ts", "eval/motionScores.ts", "eval/flashBrowser.ts", "eval/flashOnly.ts", "eval/flashWhy.ts", "eval/speed.ts", "eval/frameDump.ts"]
}
